// Hosted MCP endpoint (docs/mcp-hosted.md). Deployed by .github/workflows/mcp-worker.yml.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "perigee-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // https://perigee-mcp.<account subdomain>.workers.dev; a custom domain needs the perigee.info zone on Cloudflare.
  "workers_dev": true,
  "preview_urls": false,
  // Usage log: the Worker's own JSON line per request (workers/mcp/src/usageLog.ts: tool, object id, outcome,
  // duration, client name, country; never the IP address or the place coordinates). Cloudflare's invocation logs
  // record the request headers, IP address included: off. Kept 3 days on the free plan (200,000 lines a day).
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": false, "head_sampling_rate": 1 },
  },
  "vars": { "PERIGEE_SITE": "https://perigee.info/" },
  // Variables set in the dashboard survive deployments: the circuit breaker PERIGEE_MCP_DISABLED_TOOLS lives there
  // (docs/mcp-hosted.md, playbook), so switching a tool off needs no commit.
  "keep_vars": true,
  // Per-address budget (in memory at Cloudflare, nothing stored): 60 units a minute, a tool call costing 1 to 4
  // (handler.ts TOOL_COST). One address cannot then use up the free plan's 100,000 daily requests in a day. The
  // refusals seen at 60 a minute on 2026-10-19 came from a client looping on GET /mcp from the same address.
  "ratelimits": [{ "name": "LIMITER", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } }],
}
