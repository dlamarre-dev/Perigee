// Hosted MCP endpoint (docs/mcp-hosted.md). Deployed by .github/workflows/mcp-worker.yml.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "perigee-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // https://perigee-mcp.<account subdomain>.workers.dev; a custom domain needs the perigee.info zone on Cloudflare.
  "workers_dev": true,
  "preview_urls": false,
  // No request logs: the endpoint keeps nothing about its callers.
  "observability": { "enabled": false },
  "vars": { "PERIGEE_SITE": "https://perigee.info/" },
  // Per-IP limit (in memory at Cloudflare, nothing stored). Cloudflare counts loosely: at 60 a minute, MCP clients
  // (several requests per tool call) were refused after two or three requests; 300 leaves room for them.
  "ratelimits": [{ "name": "LIMITER", "namespace_id": "1001", "simple": { "limit": 300, "period": 60 } }],
}
