{
  "name": "perigee",
  "version": "0.0.0",
  "private": true,
  "description": "Real-time, in-browser viewer of artificial objects orbiting the Earth, the Moon, Mars and the solar system.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "textures": "tsx tools/textures/fetch-earth.ts",
    "data:fetch": "node -e \"console.log('data:fetch is available from milestone M1.')\"",
    "data:pull": "node -e \"console.log('data:pull is available from milestone M1.')\""
  },
  "dependencies": {
    "astronomy-engine": "^2.1.19",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "@types/three": "^0.186.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.9",
    "sharp": "^0.35.4",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
